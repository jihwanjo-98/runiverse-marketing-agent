# 로컬 워커 전용. 실제 값은 worker/.env 에만 두고 커밋하지 않는다.
# 워커는 DB 키를 갖지 않고 FastAPI만 호출한다.
API_BASE_URL=http://localhost:8000
WORKER_API_TOKEN=

# AWS Bedrock (Bedrock 호출 권한만 가진 IAM 사용자 키. 루트 키 금지)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Notion MCP (읽기 전용 통합 토큰, 지정 페이지만 공유)
NOTION_TOKEN=

# 리서치 배치: Claude Code 실행 파일
CLAUDE_BIN=claude

# 폴링 (초)
POLL_INTERVAL_WORK_HOURS=60
POLL_INTERVAL_OFF_HOURS=600
WORK_HOURS=09-20
TIMEZONE=Asia/Seoul
