# FastAPI 전용. 로컬은 apps/api/.env, 배포는 Vercel API 프로젝트 환경 변수에 둔다.

# Supabase Postgres 연결 풀러 주소 (transaction 모드, 포트 6543)
DATABASE_URL=

# Supabase Storage 서명 URL 발급용 (서버 전용, 브라우저에 노출 금지)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 세션 토큰 서명 키 (충분히 긴 무작위 문자열)
SESSION_SECRET=
SESSION_TTL_DAYS=30

# 웹 서버(Next.js)가 API를 호출할 때 쓰는 토큰
WEB_SERVER_TOKEN=

# 로컬 워커 · 리서치 배치 인증 토큰 (worker/.env의 WORKER_API_TOKEN과 같은 값)
WORKER_API_TOKEN=

# 비용 안전장치: 하루 최대 요청 수
DAILY_REQUEST_LIMIT=50
